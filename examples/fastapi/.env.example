# Copy to .env. Every value has a fallback in synalchemy.toml.

# A server with its own pool:
# DATABASE_URL=postgresql://app:secret@localhost:5432/app
# DB_POOL=queue
# DB_POOL_SIZE=10

# Behind a transaction pooler (PgBouncer on :6432), migrations straight to Postgres:
# DATABASE_URL=postgresql://app:secret@pgbouncer:6432/app
# DATABASE_DIRECT_URL=postgresql://app:secret@postgres:5432/app
# DB_POOL=external
